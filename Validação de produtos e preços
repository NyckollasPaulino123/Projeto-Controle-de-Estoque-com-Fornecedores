produtos = []

def cadastrar_produto():

    print("\n=== CADASTRO DE PRODUTO ===")

    nome = input("Nome do produto: ").strip()

    if nome == "":
        print("Erro: nome não pode ficar vazio.")
        return

    categoria = input("Categoria: ").strip()

    if categoria == "":
        print("Erro: categoria não pode ficar vazia.")
        return

    try:
        preco = float(input("Preço: R$ ").replace(",", "."))

        if preco <= 0:
            print("Erro: preço deve ser maior que zero.")
            return
    except ValueError:
        print("Erro: informe um preço válido.")
        return

    try:
        estoque = int(input("Quantidade em estoque: "))

        if estoque <= 0:
            print("Erro: estoque deve ser maior que zero.")
            return

    except ValueError:
        print("Erro: informe uma quantidade inteira.")
        return

    produto = {
        "nome": nome,
        "categoria": categoria,
        "preco": preco,
        "estoque": estoque
    }

    produtos.append(produto)

    print("\nProduto cadastrado com sucesso!")

def listar_produtos():

    print("\n=== PRODUTOS CADASTRADOS ===")

    if not produtos:
        print("Nenhum produto cadastrado.")
        return

    for produto in produtos:
        print("----------------------")
        print("Nome:", produto["nome"])
        print("Categoria:", produto["categoria"])
        print("Preço: R$", produto["preco"])
        print("Estoque:", produto["estoque"])


while True:

    print("\n1 - Cadastrar produto")
    print("2 - Listar produtos")
    print("3 - Sair")

    opcao = input("Escolha uma opção: ")

    if opcao == "1":
        cadastrar_produto()

    elif opcao == "2":
        listar_produtos()

    elif opcao == "3":
        print("Programa encerrado.")
        break

    else:
        print("Opção inválida!")
